{
	"$global": {
		"mcpServers": {
			"globally-available-server": {
				"command": "npx",
				"args": [
					"-y",
					"replace-with-a-global-mcp-package"
				],
				"lifecycle": "lazy",
				"samplingAutoApprove": true,
				"toolPrefix": "short"
			}
		}
	},
	"$profiles": {
		"phpstorm": {
			"mcpServers": {
				"phpstorm": {
					"command": "/absolute/command/copied/from/phpstorm",
					"args": [
						"arguments",
						"copied",
						"from",
						"phpstorm"
					],
					"lifecycle": "lazy"
				}
			}
		}
	},
	"shop-api": {
		"path": "/Users/me/Projects/shop-api",
		"profiles": [
			"phpstorm"
		],
		"mcpServers": {
			"phpstorm": {
				"toolPrefix": "none"
			}
		}
	},
	"legacy-app": {
		"path": "/Users/me/Projects/legacy-app",
		"profiles": [
			"phpstorm"
		]
	}
}
