{
	"$global": {
		"profiles": [
			"common"
		]
	},
	"$profiles": {
		"common": {
			"mcpServers": {
				"globally-available-server": {
					"command": "npx",
					"args": [
						"-y",
						"replace-with-a-global-mcp-package"
					],
					"exposure": "codemode"
				}
			}
		},
		"phpstorm": {
			"mcpServers": {
				"phpstorm": {
					"command": "/absolute/command/copied/from/phpstorm",
					"args": [
						"arguments",
						"copied",
						"from",
						"phpstorm"
					],
					"exposure": "direct"
				}
			}
		}
	},
	"shop-api": {
		"path": "/Users/me/Projects/shop-api",
		"profiles": [
			"phpstorm"
		]
	},
	"legacy-app": {
		"path": "/Users/me/Projects/legacy-app",
		"profiles": [
			"phpstorm"
		]
	}
}
